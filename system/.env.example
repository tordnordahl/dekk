APP_NAME=DekkPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
HASH_DRIVER=argon2id
APP_URL=http://localhost/dekk/system/index.php
ASSET_URL=http://localhost/dekk/system

APP_LOCALE=nb
APP_FALLBACK_LOCALE=nb
APP_FAKER_LOCALE=nb_NO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=dekkpilot
DB_USERNAME=root
DB_PASSWORD=root
DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Bestilles fra Statens vegvesen. Ikke legg nøkkelen i Git.
VEGVESEN_API_KEY=
VEGVESEN_API_URL=https://akfell-datautlevering.atlas.vegvesen.no/enkeltoppslag/kjoretoydata

# Fiken OAuth-app for SaaS. Redirect URL i Fiken: APP_URL/system/index.php/admin/regnskap/fiken/callback
FIKEN_CLIENT_ID=
FIKEN_CLIENT_SECRET=

# Tripletex gir plattformeier consumer token etter godkjenning av kommersiell integrasjon.
TRIPLETEX_CONSUMER_TOKEN=
TRIPLETEX_TEST_CONSUMER_TOKEN=

# Pris som faktureres kunden per aksepterte SMS, i øre. 0 viser kun forbruk.
SMS_BILLING_UNIT_PRICE_CENTS=0

# Full sti ved behov, eksempel /usr/bin/mysqldump eller MAMP sin binærfil.
DB_DUMP_BINARY=mysqldump

# Sikker GitHub-oppdatering for superadmin. Prosjektroten er normalt mappen over /system.
# Bruk helst en read-only Deploy Key på serveren for private GitHub-repositories.
DEPLOY_REPOSITORY_PATH=
DEPLOY_GIT_REMOTE=origin
DEPLOY_GIT_BRANCH=main
DEPLOY_GIT_BINARY=/usr/bin/git

# Stripe-produktet skal være et abonnement på NOK 249 per måned, inkl. mva.
STRIPE_SECRET=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
